# Copy to .env (local) and set the same variables in Vercel -> Project -> Settings ->
# Environment Variables (Production and Preview). Never commit real values.

# --- Ellie chat (server-only; never prefix with NEXT_PUBLIC_) ---
# Google AI Studio API key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Optional: override the Gemini model (defaults to gemini-3.5-flash, falls back to gemini-3.8-flash)
# GOOGLE_MODEL=

# --- Guestbook database (Turso) ---
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# --- GitHub OAuth (guestbook sign-in) ---
# OAuth App callback URL: https://<your-domain>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Local only. On Vercel the site URL is detected automatically; leave this unset there.
NEXTAUTH_URL=http://localhost:3000

# --- Contact form (EmailJS; these are public by design) ---
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
